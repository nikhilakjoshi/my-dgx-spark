[Unit]
Description=NVIDIA PersonaPlex voice agent (Spark)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/personaplex
ExecStart=%h/Projects/personaplex/run-server.sh
Restart=on-failure
RestartSec=5
Environment=PATH=/usr/local/cuda-13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
